# Copia este archivo como .env y completa los valores de tu proyecto Supabase
# (Supabase > Project Settings > API)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_KEY=TU_SERVICE_ROLE_KEY
SUPABASE_TABLE=tasks

# "supabase" para usar la base de datos real, "memory" para probar sin Supabase
REPOSITORY_BACKEND=supabase

# Origen permitido para el frontend (Vite)
CORS_ORIGINS=http://localhost:5173

FLASK_DEBUG=1
PORT=5000
